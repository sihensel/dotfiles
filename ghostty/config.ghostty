# if you ever need to force reload the ghostty config
# kill -USR2 $(pgrep -x ghostty)

class = ghostty
term = xterm-256color

font-family = Roboto Mono Nerd Font
font-size = 13

theme = Gruvbox Dark Hard
background = #111111
foreground = #f9f5d7
palette = 0=#504945
background-opacity = 0.93
minimum-contrast = 1.1

adjust-cursor-thickness = 1
cursor-style = underline
cursor-style-blink = false

window-theme = dark
window-decoration = none
window-padding-x = 8
window-padding-y = 6
window-save-state = never

selection-clear-on-copy = true
copy-on-select = clipboard

mouse-hide-while-typing = true
middle-click-action = ignore
right-click-action = ignore

app-notifications = no-clipboard-copy,config-reload
confirm-close-surface = false
resize-overlay = never

split-inherit-working-directory = false
tab-inherit-working-directory = false
window-inherit-working-directory = false

keybind = clear
keybind = ctrl+shift+,=reload_config
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = shift+page_down=scroll_page_down
keybind = shift+page_up=scroll_page_up
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom
