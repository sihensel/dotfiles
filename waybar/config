{
	"layer": "top",
    "height": 30,
	"modules-left": [
        "river/tags",
    ],

	"modules-center": [
        "tray",
    ],

	"modules-right": [
        "network",
        "memory",
        "cpu",
        "disk",
        "custom/pacman",
        "backlight",
        "battery",
        "wireplumber",
        "mpd",
        "clock",
    ],

	"river/tags": {
		"tag-labels":[
			"1",
			"2",
			"3",
			"4",
			"5",
			"6",
			"7",
			"8",
			"9",
		],
		"disable-click": false,
		"num-tags": 9,
	},

	"tray":{
        "icon-size": 17,
        "spacing": 8,
		"show-passive-items": true,
		"tooltip": false,
	},

    "network": {
        "interval": 15,
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "  Disconnected",
        "format-alt": "{ifname}: {ipaddr}",
        "family": "ipv4",
        "tooltip-format-wifi": "Interface: {ifname}\nSSID: {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz",
        "tooltip-format-ethernet": " 󰈀 {ifname}\nIP: {ipaddr}",
    },

    "memory": {
        "interval": 10,
        "format": "󰍛 {used:0.3f}",
        "states": {
            "warning": 85,
        },
        "tooltip": false,
    },

    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "tooltip": false,
    },

    "disk": {
        "interval": 3600,
        "format": "󰋊 {used}",
        "tooltip-format": "{used} / {total} ({percentage_used}%)",
    },

    "custom/pacman": {
        "format": " {}",
        "tooltip-format": "{} packages can be upgraded",
        "interval": 14400,
        "exec": "checkupdates | wc -l",
        "exec-if": "exit 0",
        "signal": 8,
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5,
        "min-brightness": 10.0,
        "tooltip": false,
    },

	"battery": {
        "interval": 1,
		"states": {
			"good": 100,
			"warning": 20,
			"critical": 10,
		},
		"format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰁹"],
        "tooltip": false,
	},

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-icons": ["", "", ""],
        "format-muted": "󰝟 {volume}%",
        "tooltip-format": "Node: {node_name}\n volume: {source_volume}%",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    },

    "mpd": {
        "timeout": 5,
        "format": "{stateIcon} {artist} - {title}",
        "unknown-tag": "  N/A",
        "format-stopped": "",
        "format-paused": "{stateIcon} {artist} - {title}",
        "tooltip-format": "{artist} - {title} ({totalTime:%M:%S})\n{repeatIcon} {songPosition}/{queueLength}",
        "state-icons": {
            "paused": "",
            "playing": "",
        },
        "repeat-icons": {
            "on": "󰑖",
            "off": "󰑗",
        },
        "on-click": "mpc toggle",
        "on-click-right": "mpc stop",
        "on-scroll-up": "mpc next",
        "on-scroll-down": "mpc prev",
    },

    "clock": {
        "format": " {:%A %d.%m.%Y   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "today-format": "<b>{}</b>",
        "calendar": {
            "mode"             : "month",
            "mode-mon-col"     : 3,
            "weeks-pos"        : "",
            "first-day-of-week": 1,
            "on-scroll"        : 1,
            "on-click-right"   : "mode",
            "on-middle-click"  : "shift_reset",
            "format": {
                "months":     "<span color='#b8bb26'><b>{}</b></span>",
                "days":       "<span color='#fbf1c7'><b>{}</b></span>",
                "weeks":      "<span color='#458588'><b>W{}</b></span>",
                "weekdays":   "<span color='#fabd2f'><b>{}</b></span>",
                "today":      "<span color='#fb4934'><b><u>{}</u></b></span>",
            },
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-middle-click": "shift_reset"
        },
    },
}
