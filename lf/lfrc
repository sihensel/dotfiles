# Options
set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set icons
set period 1

# open files
cmd open &{{
    set -f
    case $(file --mime-type -lb "$f") in
        text/*) lf -remote "send $id \$$editor \$fx";;
        *) for f in $fx; do $opener "$f" > /dev/null 2> /dev/null & done;;
    esac
}}

# move file into trash instead of deleting them
cmd trash ${{
    set -f
    gio trash $fx
}}

# Keybinds
map <enter> shell
map d # unmap
map dd trash
