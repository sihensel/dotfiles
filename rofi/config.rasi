// From https://github.com/AizenVisuals/bloody-carmine-dotfiles

configuration {
    modi: "drun,ssh";
    font: "Roboto Mono Nerd Font 11";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{name}";
    location: 0;
    disable-history: true;
    max-history-size: 50;
    hide-scrollbar: true;
    display-drun: " 󰣇 Apps ";
    display-ssh: "  SSH";
    sort: true;
    case-sensitive: false;
    cycle: true;
    sidebar-mode: true;
    hover-select: false;
    parse-known-hosts: false;
    click-to-exit: true;
    matching: "fuzzy";
    tokenize: true;
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }
}

@theme "/dev/null"

* {
    bg-col:  #1d2021;
    bg-col-light: #3c3836;
    fg-col: #f9f5d7;
    accent-col: #fabd2f;
    border-col: #fe8019;

    background-color: @bg-col;
    text-color: @fg-col;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg-col;
    location: center;
    anchor: center;
    width: 500px;
    border: 2px;
    border-color: @border-col;
    border-radius: 6px;
}

mainbox {
    background-color: @bg-col;
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 10px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 4px;
    spacing: 5px;
}

prompt {
    background-color: @bg-col-light;
    text-color: @border-col;
    border-radius: 8px;
    padding: 0 10px 0 0;
}

entry {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 8px;
    padding: 0 0 0 10px;
    placeholder: "Search...";
    placeholder-color: #a89984;
}

listview {
    background-color: @bg-col;
    columns: 1;
    lines: 10;
    spacing: 5px;
    border-radius: 8px;
}

element {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 8px;
    padding: 4px;
    spacing: 10px;
}

element selected {
    // background-color: @accent-col;
    border-color: @accent-col;
    text-color: #f9f5d7;
    border: 2px;
    border-radius: 5px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    background-color: inherit;
    text-color: inherit;
    size: 24px;
    vertical-align: 0.5;
}
